+// [sub100mil per-byte-cost tool] -------------------------------------------
+namespace {
+inline float ClampP(float p) {
+  const float lo = 1.0f / 65536;
+  if (!(p >= lo)) return lo;  // also catches NaN
+  if (p > 1 - lo) return 1 - lo;
+  return p;
+}
+inline void PutF32(unsigned char* d, float f) { memcpy(d, &f, 4); }
+inline void PutU16(unsigned char* d, uint16_t v) { memcpy(d, &v, 2); }
+}  // namespace
+
+Predictor::~Predictor() {
+  if (cost_log_) {
+    if (!cl_buf_.empty()) fwrite(cl_buf_.data(), 1, cl_buf_.size(), cost_log_);
+    fclose(cost_log_);
+    cost_log_ = nullptr;
+  }
+}
+
+// Called once per coded bit, right before the coder uses p_final.
+void Predictor::CostLogPredict(float p_final, float p_ppmd, float p_fxcm) {
+  if (manager_.bit_context_ == 1) {  // first bit of a byte: snapshot matches
+    memset(cl_rec_, 0, sizeof(cl_rec_));
+    int best = -1, best_len = -1;
+    for (unsigned int i = 0; i < match_models_.size(); ++i) {
+      int l = match_models_[i].MatchLengthBits();
+      if (l > best_len) best_len = l, best = i;
+    }
+    if (best >= 0) {
+      cl_rec_[1] = best_len;
+      cl_rec_[2] = match_models_[best].ExpectedByte();
+    }
+    bool delta = false;
+    fxcmv1::CostLogMatchState(cl_rec_ + 3, &delta);
+    if (delta) cl_flags_ |= 1;
+    cl_bit_ = 0;
+    static bool once = false;
+    if (!once) {
+      once = true;
+      fprintf(stderr, "FX2_COSTLOG: fxcm filled %u of %u outputs\n",
+          fxcmv1::CostLogNumFilled(), fxcm_model_->NumOutputs());
+    }
+  }
+  // The encoder's exact discretization (Encoder::Discretize).
+  cl_pdisc_ = 1 + 65534 * p_final;
+  cl_p_[0] = cl_pdisc_ / 65536.0f;
+  cl_p_[1] = ClampP(byte_mixer_output);
+  cl_p_[2] = ClampP(p_fxcm);
+  cl_p_[3] = ClampP(p_ppmd);
+}
+
+// Called at the top of Perceive(bit), before any model sees the bit.
+void Predictor::CostLogPerceive(int bit) {
+  for (int k = 0; k < 4; ++k) {
+    double q = bit ? cl_p_[k] : 1.0 - cl_p_[k];
+    cl_cost_[k] -= std::log2(q);
+  }
+  PutU16(cl_rec_ + 8 + 2 * cl_bit_, (uint16_t)cl_pdisc_);
+  ++cl_bit_;
+  if (manager_.bit_context_ >= 128) {  // last bit of the byte
+    cl_rec_[0] = (unsigned char)(manager_.bit_context_ * 2 + bit);
+    cl_rec_[7] = cl_flags_;
+    for (int k = 0; k < 4; ++k) PutF32(cl_rec_ + 24 + 4 * k, cl_cost_[k]);
+    cl_buf_.insert(cl_buf_.end(), cl_rec_, cl_rec_ + sizeof(cl_rec_));
+    if (cl_buf_.size() >= (1u << 20)) {
+      if (fwrite(cl_buf_.data(), 1, cl_buf_.size(), cost_log_) !=
+          cl_buf_.size()) Fail("FX2_COSTLOG: write failed");
+      fflush(cost_log_);
+      cl_buf_.clear();
+    }
+    for (int k = 0; k < 4; ++k) cl_cost_[k] = 0;
+    cl_flags_ = 0;
+  }
+}

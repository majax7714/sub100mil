--- /dev/null
+++ b/makefile.gcc
@@ -0,0 +1,121 @@
+# makefile.gcc - g++ port of cmix-neif-1.0's makefile (sub100mil, not upstream).
+#
+# Same translation groups and the same FP-model split as the clang makefile:
+#   fast  units: clang -ffp-model=fast -mrecip=none   -> -ffast-math -ffp-contract=fast -mrecip=none
+#   precise units: clang -ffp-model=precise -ffp-contract=off -> (gcc default IEEE) -ffp-contract=off
+# Dropped (clang/lld only): -fno-direct-access-external-data, -fuse-ld=lld-18,
+# -Wl,--icf=all, the encoder_split.lds linker script (only needed for the
+# packer's decompressor cut), clang PGO profdata.  -mno-daz-ftz keeps gcc from
+# linking crtfastmath.o (FTZ/DAZ), which the clang build also does not do.
+# -U__FAST_MATH__ stops glibc math-vector.h from declaring libmvec SIMD
+# variants (gcc otherwise vectorises log/exp into libmvec calls and emits
+# vrcpps/vrsqrt); clang never uses those declarations.  g++ 15 treats
+# -mrecip=none like the default, so -mrecip=!all is used.  One scalar
+# 1/sqrtf (rsqrtss + Newton step, in LstmLayer) remains: gcc emits it under
+# -funsafe-math-optimizations regardless of -mrecip.  It is deterministic on
+# one CPU; it only matters for decoding on a different CPU vendor.
+# AVX2 only: -march=x86-64-v3 -mtune=znver2, never -march=native.
+#
+#   make -f makefile.gcc            plain -O3/-flto build (no PGO)  -> ./cmix
+#   make -f makefile.gcc PGO=gen    instrumented build
+#   make -f makefile.gcc PGO=use    build using ./pgo_gcc profile
+#   make -f makefile.gcc PROF=1     adds -pg for gprof (no LTO)
+
+CXX      ?= g++
+DEFS     := -DSEED=923 -DUPDATE_LIMIT=3000 -DNDEBUG $(XDEFS)
+ifeq ($(AUX),1)
+  DEFS += -DAUX_BUILD=1
+endif
+ARCH     := -march=x86-64-v3 -mtune=znver2
+COMMON   := -m64 -std=c++17 $(ARCH) -fno-pie -fno-exceptions -fno-unwind-tables \
+            -fno-asynchronous-unwind-tables -fdata-sections -ffunction-sections -w
+FASTFP   := -ffast-math -ffp-contract=fast -mrecip=!all -U__FAST_MATH__
+PRECFP   := -ffp-contract=off -fno-math-errno -mrecip=!all
+BASE     := $(DEFS) $(COMMON) -fno-threadsafe-statics -fno-rtti -fvisibility=hidden -fmerge-all-constants -fno-unroll-loops
+
+LTO      := -flto=auto
+EXTRA    :=
+ifeq ($(PGO),gen)
+  EXTRA  += -fprofile-generate=$(CURDIR)/pgo_gcc -fprofile-update=single
+endif
+ifeq ($(PGO),use)
+  EXTRA  += -fprofile-use=$(CURDIR)/pgo_gcc -fprofile-partial-training -Wno-missing-profile
+endif
+ifeq ($(PROF),1)
+  EXTRA  += -pg
+  LTO    :=
+endif
+
+FAST_FLAGS := $(BASE) $(FASTFP) -O3 $(LTO) $(EXTRA)
+SLOW_FLAGS := $(BASE) $(FASTFP) -Os $(EXTRA)
+COLD_FLAGS := $(BASE) $(FASTFP) -Os $(EXTRA)
+PREC_O2    := $(DEFS) $(COMMON) -fno-rtti -fvisibility=hidden $(PRECFP) -O2 -fno-builtin $(EXTRA)
+PREC_O3    := $(DEFS) $(COMMON) -fno-rtti -fvisibility=hidden $(PRECFP) -O3 -fno-builtin $(EXTRA)
+PREC_OS    := $(DEFS) $(COMMON) -fno-rtti -fvisibility=hidden $(PRECFP) -Os -fno-builtin $(EXTRA)
+TF1_FLAGS  := $(DEFS) $(COMMON) -fno-rtti -fvisibility=hidden $(PRECFP) -O3 $(EXTRA)
+TF1_OS     := $(DEFS) $(COMMON) -fno-rtti -fvisibility=hidden $(PRECFP) -Os $(EXTRA)
+
+FAST_SRC := src/coder/decoder.cpp src/coder/encoder.cpp src/context-manager.cpp src/contexts/bit-context.cpp \
+  src/contexts/bracket-context.cpp src/contexts/combined-context.cpp src/contexts/context-hash.cpp \
+  src/contexts/indirect-hash.cpp src/contexts/interval-hash.cpp src/contexts/interval.cpp src/contexts/sparse.cpp \
+  src/models/bracket.cpp src/models/byte-model.cpp src/models/direct-hash.cpp src/models/direct.cpp \
+  src/models/indirect.cpp src/models/match.cpp src/models/grammar-match.cpp src/models/fxcmv1.cpp src/models/ppmd.cpp \
+  src/states/nonstationary.cpp src/states/run-map.cpp src/mixer/byte-mixer.cpp src/mixer/mixer-input.cpp \
+  src/mixer/mixer.cpp src/mixer/sigmoid.cpp src/mixer/sse.cpp src/predictor.cpp
+SLOW_SRC := src/preprocess/preprocessor.cpp src/preprocess/dictionary.cpp
+COLD_SRC := src/r1_reorder_transform.cpp src/runner.cpp src/glibc_compat.cpp src/preprocess/dict_derive.cpp
+TF1_SRC  := src/tf1/tf1_engine.cpp src/tf1/kernels.cpp src/tf1/model.cpp src/tf1/opt/attn.cpp src/tf1/opt/glue.cpp \
+  src/tf1/opt/kda.cpp src/tf1/opt/qmat_dense.cpp src/tf1/opt/qmat_sparse.cpp src/tf1/opt/model_opt.cpp \
+  src/tf1/tf1_z3.cpp src/tf1/tf1_prompt.cpp src/tf1/tf1_gate.cpp
+TF1_OSRC := src/tf1/weights_io.cpp src/tf1/weights_io_compressed.cpp src/tf1/opt/arena_build.cpp
+
+O := obj
+obj = $(addprefix $(O)/,$(subst /,_,$(1:.cpp=.o)))
+
+FAST_OBJ := $(call obj,$(FAST_SRC))
+SLOW_OBJ := $(call obj,$(SLOW_SRC))
+COLD_OBJ := $(call obj,$(COLD_SRC))
+TF1_OBJ  := $(call obj,$(TF1_SRC))
+TF1_OOBJ := $(call obj,$(TF1_OSRC))
+PREC_OBJ := $(O)/src_detmath.o $(O)/src_fast_math_vec.o $(O)/src_optimizer_vec.o $(O)/src_bit_head.o \
+            $(O)/src_adaptive_depth.o $(O)/src_word_label.o
+ALL_OBJ  := $(FAST_OBJ) $(SLOW_OBJ) $(COLD_OBJ) $(TF1_OBJ) $(TF1_OOBJ) $(PREC_OBJ)
+
+LFLAGS := -m64 -no-pie -Wl,--gc-sections -Wl,-z,norelro -Wl,--version-script=runtime_exports.map \
+          -Wl,--as-needed -Wl,--build-id=none -mno-daz-ftz
+
+# OUT names the binary; the build helper is
+#   make -f makefile.gcc OUT=cmix_aux O=obj_aux AUX=1
+OUT ?= cmix
+$(OUT): $(ALL_OBJ)
+	$(CXX) $(FAST_FLAGS) $(LFLAGS) $(ALL_OBJ) -o $@
+
+define rule
+$(call obj,$(1)): $(1) | $(O)
+	$$(CXX) $(2) -c $$< -o $$@
+endef
+# mixer-input.cpp holds a build check (eps != min_ || (1 - eps) != max_) that
+# gcc's reassociation under -ffast-math folds differently from clang's, so it
+# aborts at start-up although the values agree.  Compile it without
+# associative/reciprocal math; the hot MixerInput code is inline in its header.
+FAST_SRC_STRICT := src/mixer/mixer-input.cpp
+$(foreach s,$(filter-out $(FAST_SRC_STRICT),$(FAST_SRC)),$(eval $(call rule,$(s),$$(FAST_FLAGS))))
+$(foreach s,$(FAST_SRC_STRICT),$(eval $(call rule,$(s),$$(FAST_FLAGS) -fno-associative-math -fno-reciprocal-math)))
+$(foreach s,$(SLOW_SRC),$(eval $(call rule,$(s),$$(SLOW_FLAGS))))
+$(foreach s,$(COLD_SRC),$(eval $(call rule,$(s),$$(COLD_FLAGS))))
+$(foreach s,$(TF1_SRC),$(eval $(call rule,$(s),$$(TF1_FLAGS))))
+$(foreach s,$(TF1_OSRC),$(eval $(call rule,$(s),$$(TF1_OS))))
+$(eval $(call rule,src/detmath.cpp,$$(PREC_O2)))
+$(eval $(call rule,src/fast_math_vec.cpp,$$(PREC_O3)))
+$(eval $(call rule,src/optimizer_vec.cpp,$$(PREC_O3)))
+$(eval $(call rule,src/bit_head.cpp,$$(PREC_O3)))
+$(eval $(call rule,src/adaptive_depth.cpp,$$(PREC_O2)))
+$(eval $(call rule,src/word_label.cpp,$$(PREC_OS)))
+
+$(O):
+	mkdir -p $(O)
+
+clean:
+	rm -rf $(O) cmix
+
+.PHONY: clean

diff --git a/src/models/wrt_dec.h b/src/models/wrt_dec.h
new file mode 100644
index 0000000..d874690
--- /dev/null
+++ b/src/models/wrt_dec.h
@@ -0,0 +1,121 @@
+// [sub100mil C4] The WRT (phda9 word-replacing transform) decoder shared by X2 (x2_timelaw.h) and T1
+// (t1_fieldcopy.h). Both used to carry identical copies of the byte swap table, the dictionary loader and the
+// decoding state machine. Now one table set is loaded per dictionary path (shared while any user holds it) and
+// each model keeps only the small decoder state and a Sink that receives the decoded text. The decoding is the
+// same code path as before (same branches, same order), so the text each model sees is unchanged.
+#pragma once
+#include <cctype>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace wrt {
+
+struct Tables {
+  bool ok = false;
+  int swap[256];      // coded byte -> decoded symbol
+  uint8_t enc[256];   // decoded symbol -> coded byte
+  std::unordered_map<uint32_t, std::string> dict;  // word code -> lower-case word
+};
+
+// The tables for dictionary DICT_PATH; loaded once while some model holds them. ok is false if the file can't be read.
+inline std::shared_ptr<const Tables> Load(const char* dict_path) {
+  static std::string last_path;
+  static std::weak_ptr<const Tables> last;
+  if (auto t = last.lock()) if (last_path == dict_path) return t;
+  auto t = std::make_shared<Tables>();
+  for (int c = 0; c < 256; c++) {
+    int d = c;
+    if ('{' <= d && d < 127) d += 'P' - '{';
+    else if ('P' <= d && d < 'T') d -= 'P' - '{';
+    else if ((':' <= d && d <= '?') || ('J' <= d && d <= 'O')) d ^= 0x70;
+    if (d == 'X' || d == '`') d ^= 'X' ^ '`';
+    t->swap[c] = d;
+  }
+  for (int c = 0; c < 256; c++) t->enc[t->swap[c] & 0xFF] = (uint8_t)c;
+  FILE* f = fopen(dict_path, "rb");
+  if (!f) return t;
+  std::string data;
+  char buf[65536];
+  size_t r;
+  while ((r = fread(buf, 1, sizeof buf, f)) > 0) data.append(buf, r);
+  fclose(f);
+  std::vector<std::string> words;
+  std::string cur;
+  for (char c : data) {
+    if (c >= 'a' && c <= 'z') cur += c;
+    else if (!cur.empty()) { words.push_back(cur); cur.clear(); }
+  }
+  if (!cur.empty()) words.push_back(cur);
+  const int b1 = 80, b2 = 80 + 3840, b3 = 80 + 3840 + 40960;
+  for (int n = 0; n < (int)words.size() && n < b3; n++) {
+    uint32_t code;
+    if (n < b1) code = 0x80 + n;
+    else if (n < b2) code = (0xD0 + (n - b1) / 80) + ((0x80 + (n - b1) % 80) << 8);
+    else { int m = n - b2; code = (0xF0 + (m / 80) / 32) + ((0xD0 + (m / 80) % 32) << 8) + ((0x80 + m % 80) << 16); }
+    t->dict[code] = words[n];
+  }
+  t->ok = true;
+  last = t;
+  last_path = dict_path;
+  return t;
+}
+
+class Sink {
+ public:
+  virtual void Text(char ch) = 0;
+ protected:
+  ~Sink() = default;
+};
+
+// Decoder state; Byte() feeds the decoded characters of one coded byte to the sink (none while a word code is
+// incomplete or for a case/escape marker). A dictionary word never contains '\n'.
+class Decoder {
+ public:
+  explicit Decoder(const Tables* t) : t_(t) {}
+  void Byte(uint8_t byte, Sink* s) {
+    int c = t_->swap[byte];
+    if (code_need_ > 0) {
+      code_ += (uint32_t)c << code_shift_;
+      code_shift_ += 8;
+      if (c > 0xCF && code_shift_ < 24) return;
+      code_need_ = 0;
+      Word(s);
+    } else if (esc_) {
+      esc_ = false; upper_ = false; s->Text((char)c);
+    } else if (c == 0x0C) { esc_ = true; }
+    else if (c == 0x07) { upper_ = true; }
+    else if (c == 0x40) { capital_ = true; }
+    else if (c == 0x06) { upper_ = false; }
+    else if (c >= 0x80) {
+      code_ = c; code_shift_ = 8;
+      if (c > 0xCF) { code_need_ = 1; return; }
+      Word(s);
+    } else {
+      if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) upper_ = false;
+      if (capital_ || upper_) c = c - 'a' + 'A';
+      capital_ = false;
+      s->Text((char)(c & 0xFF));
+    }
+  }
+
+ private:
+  const Tables* t_;
+  bool upper_ = false, capital_ = false, esc_ = false;
+  int code_need_ = 0, code_shift_ = 0;
+  uint32_t code_ = 0;
+  void Word(Sink* s) {
+    auto it = t_->dict.find(code_);
+    std::string w = it == t_->dict.end() ? std::string() : it->second;
+    if (!w.empty()) {
+      if (capital_) { w[0] -= 32; capital_ = false; }
+      if (upper_) for (auto& ch : w) ch = (char)toupper((unsigned char)ch);
+    }
+    for (char ch : w) s->Text(ch);
+  }
+};
+
+}  // namespace wrt

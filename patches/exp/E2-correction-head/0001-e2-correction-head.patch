--- a/cpp_infer/src/opt/model_opt.h
+++ b/cpp_infer/src/opt/model_opt.h
@@ -24,6 +24,26 @@ enum class AttnKind : int { KVF32 = 0, KVI8 = 1 };
 
 struct TransformerOptImpl;
 
+// [sub100mil E2] online correction head on the frozen transformer. Runtime
+// state only (zero-initialized, learned from already-coded symbols, identical
+// in compressor and decompressor); nothing is stored in the archive.
+//  fwk   > 0: ex-girlfriend-style fast weights. The relu^2 codes h_b of the
+//              last fwk MLP blocks drive a residual correction
+//              dx = sum_b dW_b h_b (dW_b: 192 x 768, zero init); a second head
+//              reads x + dx through the frozen final norm/unembedding/softcap.
+//  logit = 1:  a 205 x (192+1) logit-space correction A [xn; 1] added to the
+//              pre-softcap logits of that second head (online softmax
+//              regression on the final normalized hidden state).
+// Both are trained by one SGD step per predicted token on the second head's
+// own cross-entropy (fixed float op order -> deterministic).
+struct E2Config {
+  int fwk = 0;                 // 0..4 FW blocks
+  int logit = 0;               // 0/1 logit-space head
+  float k0 = 6.0e-3f, kf = 1.5e-3f, tau = 8000.0f;  // FW kappa_t schedule
+  float a0 = 0.5f, af = 0.1f, atau = 8000.0f;       // logit head schedule
+  bool on() const { return fwk > 0 || logit; }
+};
+
 struct TransformerOpt {
   explicit TransformerOpt(const char* weights_path,
                           AttnKind attn = AttnKind::KVF32);
@@ -46,6 +66,12 @@ struct TransformerOpt {
 
   AttnKind attn_kind() const;
 
+  // [sub100mil E2] see E2Config. e2_probs() is the second head's distribution
+  // of the last step (valid when on()); e2_update(y) trains on target y.
+  void e2_set(const E2Config& cfg);
+  const float* e2_probs() const;
+  void e2_update(uint8_t target);
+
  private:
   std::unique_ptr<TransformerOptImpl> impl;
 };

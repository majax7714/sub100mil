+// [sub100mil E9] how many outputs fxcm filled for the current bit; the last
+// one filled is fxcm's own final prediction (its APM average).
+unsigned int e9_last_filled = 0;
 void ResetPredictions() {
     assert(prediction_index >= 0 && prediction_index <= num_models);
+    e9_last_filled = prediction_index;
     prediction_index = 0;
 }
 
@@ -4829,6 +4833,19 @@ unsigned int FXCM::NumOutputs() {
     return fxcmv1::model_predictions.size();
 }
 
+// [sub100mil E9] index (within fxcm's outputs) of fxcm's final prediction.
+// The record used the last slot (num_models - 1), but fxcm fills only 429 of
+// its 431 outputs, so that slot is the constant 0.5. E9_FXCM_FINAL=0 restores
+// the record's behaviour (encoder and decoder must agree).
+static const bool e9_on = [] {
+    const char* v = getenv("E9_FXCM_FINAL");
+    return !(v && *v && atoi(v) == 0);
+}();
+unsigned int FXCM::FinalIndex() const {
+    if (e9_on && fxcmv1::e9_last_filled) return fxcmv1::e9_last_filled - 1;
+    return fxcmv1::model_predictions.size() - 1;
+}

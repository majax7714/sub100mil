+  bool e10_lora(int l) const {
+    return e10.on && (e10.sites & 32) && l >= e10.lmin && e10.rank > 0;
+  }
+  bool e10_act(int l) const { return e10.on && l >= e10.lmin; }
+  bool e10_bk(int l) const { return e10.on && l >= NL - e10.mlpbk; }
+
+  // replaces qgemv_add(m, q5, x) for the attention/KDA output projection
+  void e10_attn_out(const QDense& m) {
+    if (!e10_act(cur_l)) {
+      qgemv_add(m, q5, x);
+      return;
+    }
+    float* y = e10_ya[cur_l];
+    std::memset(y, 0, sizeof(float) * D);
+    qgemv_add(m, q5, y);
+    const float* g = e10_ga[cur_l];
+    const float* b = e10_ba[cur_l];
+    for (int i = 0; i < D; i++) x[i] += g[i] * y[i] + b[i];
+  }
+
+  // fixed-order dot of an int8[192] row with a float[192] vector
+  static float e10_dot_i8(const int8_t* w, const float* v) {
+    __m256 a0 = _mm256_setzero_ps(), a1 = a0, a2 = a0;
+    for (int j = 0; j < D; j += 24) {
+      const __m256 w0 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(
+          _mm_loadl_epi64(reinterpret_cast<const __m128i*>(w + j))));
+      const __m256 w1 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(
+          _mm_loadl_epi64(reinterpret_cast<const __m128i*>(w + j + 8))));
+      const __m256 w2 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(
+          _mm_loadl_epi64(reinterpret_cast<const __m128i*>(w + j + 16))));
+      a0 = _mm256_fmadd_ps(w0, _mm256_loadu_ps(v + j), a0);
+      a1 = _mm256_fmadd_ps(w1, _mm256_loadu_ps(v + j + 8), a1);
+      a2 = _mm256_fmadd_ps(w2, _mm256_loadu_ps(v + j + 16), a2);
+    }
+    return hsum8(_mm256_add_ps(_mm256_add_ps(a0, a1), a2));
+  }
+
+  // out[0..192) = sum_k c[k] * rows[idx[k]][0..192) (int8 rows), fixed order
+  static void e10_axpy_rows(const int8_t* rows, const uint16_t* idx,
+                            const float* c, int n, float* out) {
+    for (int half = 0; half < 2; half++) {
+      const int j0 = half * 96;
+      __m256 a[12];
+      for (int r = 0; r < 12; r++) a[r] = _mm256_setzero_ps();
+      for (int k = 0; k < n; k++) {
+        const int8_t* row = rows + size_t(idx[k]) * D + j0;
+        const __m256 cv = _mm256_set1_ps(c[k]);
+        for (int r = 0; r < 12; r++)
+          a[r] = _mm256_fmadd_ps(
+              _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_loadl_epi64(
+                  reinterpret_cast<const __m128i*>(row + 8 * r)))),
+              cv, a[r]);
+      }
+      for (int r = 0; r < 12; r++) _mm256_storeu_ps(out + j0 + 8 * r, a[r]);
+    }
+  }
+
+  // MLP down projection into y (pre branch gain), plus the hidden-gain
+  // correction, then x += gm*y + bm
+  void e10_mlp_out(int l, int nnz) {
+    MlpArenas& mm = M.mlp[l];
+    float* y = e10_ym[l];
+    std::memset(y, 0, sizeof(float) * D);
+    if (nnz > DOWN_DENSE_NNZ)
+      qsparse4_dense_add(mm.down, q768, y);
+    else
+      qsparse4_add(mm.down, q768, idx768, nnz, y);
+    if (e10_bk(l) && (e10.sites & 16)) {
+      alignas(64) float c[DMLP];
+      const float sd = mm.down_s_act;
+      for (int k = 0; k < nnz; k++)
+        c[k] = float(q768[idx768[k]]) * sd * e10_gh[l][idx768[k]];
+      alignas(64) float dy[D];
+      e10_axpy_rows(M.e10_dnT8[l].data(), idx768, c, nnz, dy);
+      const float* ws = M.e10_dn_ws[l].data();
+      for (int o = 0; o < D; o++) y[o] += dy[o] * ws[o];
+    }
+    const float* g = e10_gm[l];
+    const float* b = e10_bm[l];
+    for (int i = 0; i < D; i++) x[i] += g[i] * y[i] + b[i];
+    if (e10_lora(l)) {
+      const int r = e10.rank;
+      const float* A = e10_A.data() + size_t(l) * r * D;
+      const float* B = e10_B.data() + size_t(l) * D * r;
+      float* u = e10_u[l];
+      for (int k = 0; k < r; k++) {
+        float acc = 0.0f;
+        for (int i = 0; i < D; i++) acc += A[size_t(k) * D + i] * e10_xnm[l][i];
+        u[k] = acc;
+      }
+      for (int i = 0; i < D; i++) {
+        float acc = 0.0f;
+        for (int k = 0; k < r; k++) acc += B[size_t(i) * r + k] * u[k];
+        x[i] += acc;
+      }
+    }
+  }
+
+  // grad of the MLP block's input x given dy = grad of its down output y;
+  // ghg[k] (nullable) = grad of the hidden gain of nonzero neuron k
+  void e10_mlp_back(int l, const float* dy, float* dx, float* ghg) {
+    const int8_t* dT = M.e10_dnT8[l].data();
+    const float* wsd = M.e10_dn_ws[l].data();
+    const float* wsu = M.e10_up_ws[l].data();
+    const float sd = M.mlp[l].down_s_act;
+    alignas(64) float gf[D];
+    for (int o = 0; o < D; o++) gf[o] = dy[o] * wsd[o];
+    const int nnz = e10_nnz[l];
+    const uint16_t* idx = e10_idx[l];
+    const uint8_t* q = e10_q[l];
+    alignas(64) float c[DMLP];
+    for (int k = 0; k < nnz; k++) {
+      const int i = idx[k];
+      const float dhp = e10_dot_i8(dT + size_t(i) * D, gf);  // dL/dh'_i
+      const float h = float(q[i]) * sd;
+      if (ghg) ghg[k] = dhp * h;
+      const float dh = dhp * (1.0f + e10_gh[l][i]);
+      c[k] = 2.0f * std::sqrt(h) * dh * wsu[i];  // relu^2' (STE), up scale
+    }
+    alignas(64) float dxn[D];
+    e10_axpy_rows(M.e10_up8[l].data(), idx, c, nnz, dxn);
+    const float* xnm = e10_xnm[l];
+    float m = 0.0f;
+    for (int i = 0; i < D; i++) m += dxn[i] * xnm[i];
+    m *= (1.0f / float(D));
+    const float r = e10_rinvm[l];
+    for (int i = 0; i < D; i++) dx[i] = r * (dxn[i] - xnm[i] * m);
+  }
+
+  void e10_step(float* th, float* v, const float* g, int n, float lr,
+                float init, float bc) {
+    if (e10.opt == 0) {
+      for (int i = 0; i < n; i++) th[i] -= lr * g[i];
+    } else {
+      const float b = e10.beta, b1 = 1.0f - e10.beta, eps = e10.eps;
+      for (int i = 0; i < n; i++) {
+        v[i] = b * v[i] + b1 * (g[i] * g[i]);

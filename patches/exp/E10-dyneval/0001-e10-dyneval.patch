index 4c3586a..c89fc33 100644
--- a/cpp_infer/src/opt/qmat_dense.cpp
+++ b/cpp_infer/src/opt/qmat_dense.cpp
@@ -371,6 +371,77 @@ int qgemv_relu2q(const QDense& m, const uint8_t* act, float s_next,

+  // ---- [sub100mil E10] dynamic evaluation (see model_opt.h E10Config) ----
+  E10Config e10;
+  int cur_l = 0;
+  float e10_bt = 1.0f;  // beta^t (Adam bias correction)
+  // adapted parameters [l][i]: branch gains are multipliers (init 1), biases
+  // and hidden-neuron gain deltas start at 0
+  alignas(64) float e10_ga[NL][D], e10_gm[NL][D];
+  alignas(64) float e10_ba[NL][D] = {}, e10_bm[NL][D] = {};
+  alignas(64) float e10_vga[NL][D] = {}, e10_vgm[NL][D] = {};
+  alignas(64) float e10_vba[NL][D] = {}, e10_vbm[NL][D] = {};
+  alignas(64) float e10_gh[NL][DMLP], e10_vgh[NL][DMLP] = {};  // gh init 1
+  // forward caches of the last step
+  alignas(64) float e10_ya[NL][D] = {}, e10_ym[NL][D] = {};
+  alignas(64) float e10_xnm[NL][D] = {};
+  float e10_rinvm[NL] = {};
+  alignas(64) float e10_y[NL][DMLP] = {};  // mlp.up pre-activations
+  int e10_nnz[NL] = {};
+  alignas(64) uint16_t e10_kidx[NL][DMLP + 16] = {};  // backward-kept neurons
+  int e10_knnz[NL] = {};
+  uint64_t e10_stat_nnz = 0, e10_stat_kept = 0, e10_stat_steps = 0;
+  ~TransformerOptImpl() {
+    if (e10.on && e10_stat_steps)
+      fprintf(stderr, "\nE10 stats: %llu updates, mean nnz %.1f kept %.1f per "
+              "backprop layer\n", (unsigned long long)e10_stat_steps,
+              double(e10_stat_nnz) / double(e10_stat_steps * e10.mlpbk + 1e-9),
+              double(e10_stat_kept) / double(e10_stat_steps * e10.mlpbk + 1e-9));
+  }
+  alignas(64) float e10_xnf[D] = {}, e10_lc[208] = {}, e10_p[208] = {};
+  float e10_rinvf = 0.0f;
+  // sites bit5: low-rank residual branch per layer, x += B (A xn_mlp)
+  // (A [r][D] small deterministic init, B [D][r] zero init)
+  static constexpr int E10_RMAX = 16;
+  std::vector<float> e10_A, e10_B, e10_vA, e10_vB;  // [NL][r][D], [NL][D][r]
+  alignas(64) float e10_u[NL][E10_RMAX] = {};
+
+  void e10_set(const E10Config& c) {
+    e10 = c;
+    if (e10.lmin < 0) e10.lmin = 0;
+    if (e10.mlpbk < 0) e10.mlpbk = 0;
+    if (e10.mlpbk > NL - e10.lmin) e10.mlpbk = NL - e10.lmin;
+    for (int l = 0; l < NL; l++)
+      for (int i = 0; i < D; i++) e10_ga[l][i] = e10_gm[l][i] = 1.0f;
+    for (int l = 0; l < NL; l++)
+      for (int i = 0; i < DMLP; i++) e10_gh[l][i] = 1.0f;
+    if (e10.rank < 0) e10.rank = 0;
+    if (e10.rank > E10_RMAX) e10.rank = E10_RMAX;
+    if (e10.sites & 32) {
+      const int r = e10.rank;
+      e10_A.assign(size_t(NL) * r * D, 0.0f);
+      e10_B.assign(size_t(NL) * D * r, 0.0f);
+      e10_vA.assign(e10_A.size(), 0.0f);
+      e10_vB.assign(e10_B.size(), 0.0f);
+      uint32_t st = 0x12345678u;  // fixed LCG: uniform in [-a, a]
+      const float a = e10.ainit;
+      for (size_t k = 0; k < e10_A.size(); k++) {
+        st = st * 1664525u + 1013904223u;
+        e10_A[k] = a * (float(st >> 8) * (2.0f / 16777216.0f) - 1.0f);
+      }
+    }
+  }
+  bool e10_lora(int l) const {
+    return e10.on && (e10.sites & 32) && l >= e10.lmin && e10.rank > 0;
+  }
+  bool e10_act(int l) const { return e10.on && l >= e10.lmin; }
+  bool e10_bk(int l) const { return e10.on && l >= NL - e10.mlpbk; }
+
+  // replaces qgemv_add(m, q5, x) for the attention/KDA output projection
+  void e10_attn_out(const QDense& m) {
+    if (!e10_act(cur_l)) {
+      qgemv_add(m, q5, x);
+      return;
+    }
+    float* y = e10_ya[cur_l];
+    std::memset(y, 0, sizeof(float) * D);
+    qgemv_add(m, q5, y);
+    const float* g = e10_ga[cur_l];
+    const float* b = e10_ba[cur_l];
+    for (int i = 0; i < D; i++) x[i] += g[i] * y[i] + b[i];
+  }
+
+  // dh pass: exact int32 dot of int4 down column i (QSparse4 layout: byte b
+  // low nibble = row b + 7, high nibble = row 96 + b + 7) with int16 gq[192]
+  static int32_t e10_col_dot(const uint8_t* col, const int16_t* gq) {
+    const __m256i m4 = _mm256_set1_epi8(0x0F);
+    __m256i acc = _mm256_setzero_si256();
+    for (int p = 0; p < 3; p++) {
+      const __m256i v =
+          _mm256_load_si256(reinterpret_cast<const __m256i*>(col + 32 * p));
+      const __m256i lo = _mm256_and_si256(v, m4);
+      const __m256i hi = _mm256_and_si256(_mm256_srli_epi16(v, 4), m4);
+      const int16_t* g0 = gq + 32 * p;
+      const int16_t* g1 = gq + 96 + 32 * p;
+      acc = _mm256_add_epi32(acc, _mm256_madd_epi16(
+          _mm256_cvtepu8_epi16(_mm256_castsi256_si128(lo)),
+          _mm256_load_si256(reinterpret_cast<const __m256i*>(g0))));
+      acc = _mm256_add_epi32(acc, _mm256_madd_epi16(
+          _mm256_cvtepu8_epi16(_mm256_extracti128_si256(lo, 1)),
+          _mm256_load_si256(reinterpret_cast<const __m256i*>(g0 + 16))));
+      acc = _mm256_add_epi32(acc, _mm256_madd_epi16(
+          _mm256_cvtepu8_epi16(_mm256_castsi256_si128(hi)),
+          _mm256_load_si256(reinterpret_cast<const __m256i*>(g1))));
+      acc = _mm256_add_epi32(acc, _mm256_madd_epi16(
+          _mm256_cvtepu8_epi16(_mm256_extracti128_si256(hi, 1)),
+          _mm256_load_si256(reinterpret_cast<const __m256i*>(g1 + 16))));
+    }
+    __m128i t = _mm_add_epi32(_mm256_castsi256_si128(acc),
+                              _mm256_extracti128_si256(acc, 1));
+    t = _mm_add_epi32(t, _mm_shuffle_epi32(t, _MM_SHUFFLE(1, 0, 3, 2)));
+    t = _mm_add_epi32(t, _mm_shuffle_epi32(t, _MM_SHUFFLE(2, 3, 0, 1)));
+    return _mm_cvtsi128_si32(t);
+  }
+
+  // dxn pass: out[j] = sum_k cq[k] * W_up[idx[k]][j] (exact int32), rows read
+  // from the dense G8 arena (d_in 192: group block 1600 B = 64 B meta + 6
+  // chunks x 8 rows x 32 B). n must be even (caller pads).
+  static void e10_rows_axpy(const uint8_t* arena, const uint16_t* idx,
+                            const int16_t* cq, int n, int32_t* out) {
+    for (int half = 0; half < 2; half++) {
+      __m256i a[12];
+      for (int r = 0; r < 12; r++) a[r] = _mm256_setzero_si256();
+      for (int k = 0; k < n; k += 2) {
+        const uint8_t* ra =
+            arena + size_t(idx[k] >> 3) * 1600 + 64 + (idx[k] & 7) * 32;
+        const uint8_t* rb =
+            arena + size_t(idx[k + 1] >> 3) * 1600 + 64 + (idx[k + 1] & 7) * 32;
+        const __m256i cp = _mm256_set1_epi32(int32_t(
+            uint32_t(uint16_t(cq[k])) | (uint32_t(uint16_t(cq[k + 1])) << 16)));
+        for (int cc = 0; cc < 3; cc++) {
+          const int off = (3 * half + cc) * 256;
+          const __m256i A0 = _mm256_cvtepi8_epi16(
+              _mm_load_si128(reinterpret_cast<const __m128i*>(ra + off)));
+          const __m256i A1 = _mm256_cvtepi8_epi16(
+              _mm_load_si128(reinterpret_cast<const __m128i*>(ra + off + 16)));
+          const __m256i B0 = _mm256_cvtepi8_epi16(
+              _mm_load_si128(reinterpret_cast<const __m128i*>(rb + off)));
+          const __m256i B1 = _mm256_cvtepi8_epi16(
+              _mm_load_si128(reinterpret_cast<const __m128i*>(rb + off + 16)));
+          a[4 * cc + 0] = _mm256_add_epi32(a[4 * cc + 0], _mm256_madd_epi16(
+              _mm256_unpacklo_epi16(A0, B0), cp));
+          a[4 * cc + 1] = _mm256_add_epi32(a[4 * cc + 1], _mm256_madd_epi16(
+              _mm256_unpackhi_epi16(A0, B0), cp));
+          a[4 * cc + 2] = _mm256_add_epi32(a[4 * cc + 2], _mm256_madd_epi16(
+              _mm256_unpacklo_epi16(A1, B1), cp));
+          a[4 * cc + 3] = _mm256_add_epi32(a[4 * cc + 3], _mm256_madd_epi16(
+              _mm256_unpackhi_epi16(A1, B1), cp));
+        }
+      }
+      // un-permute: for a 16-column block j0, unpacklo holds j0+{0..3, 8..11}
+      // and unpackhi j0+{4..7, 12..15}
+      for (int cc = 0; cc < 3; cc++)
+        for (int s16 = 0; s16 < 2; s16++) {
+          const __m256i lo = a[4 * cc + 2 * s16], hi = a[4 * cc + 2 * s16 + 1];
+          int32_t* o = out + (3 * half + cc) * 32 + 16 * s16;
+          _mm256_storeu_si256(reinterpret_cast<__m256i*>(o),
+                              _mm256_permute2x128_si256(lo, hi, 0x20));
+          _mm256_storeu_si256(reinterpret_cast<__m256i*>(o + 8),
+                              _mm256_permute2x128_si256(lo, hi, 0x31));
+        }
+    }
+  }
+
+  // symmetric int16 quantization of v[n] (deterministic: exact max, IEEE
+  // multiply, cvtps round-to-nearest-even); n must be a multiple of 16 and
+  // v padded with zeros; returns the scale (0 if v == 0)
+  static float e10_q16(const float* v, int n, int16_t* q) {
+    const __m256 sm = _mm256_castsi256_ps(_mm256_set1_epi32(0x7fffffff));
+    __m256 mx = _mm256_setzero_ps();
+    for (int i = 0; i < n; i += 8)
+      mx = _mm256_max_ps(mx, _mm256_and_ps(_mm256_loadu_ps(v + i), sm));
+    alignas(32) float t[8];
+    _mm256_store_ps(t, mx);
+    float m = t[0];
+    for (int i = 1; i < 8; i++) m = std::max(m, t[i]);
+    if (!(m > 0.0f)) {
+      std::memset(q, 0, sizeof(int16_t) * n);
+      return 0.0f;
+    }
+    const __m256 inv = _mm256_set1_ps(32767.0f / m);
+    const __m256i lim = _mm256_set1_epi32(32767), nlim = _mm256_set1_epi32(-32767);
+    for (int i = 0; i < n; i += 16) {
+      __m256i a = _mm256_cvtps_epi32(_mm256_mul_ps(_mm256_loadu_ps(v + i), inv));
+      __m256i b = _mm256_cvtps_epi32(_mm256_mul_ps(_mm256_loadu_ps(v + i + 8), inv));
+      a = _mm256_max_epi32(_mm256_min_epi32(a, lim), nlim);
+      b = _mm256_max_epi32(_mm256_min_epi32(b, lim), nlim);
+      const __m256i p = _mm256_permute4x64_epi64(_mm256_packs_epi32(a, b),
+                                                 _MM_SHUFFLE(3, 1, 2, 0));
+      _mm256_storeu_si256(reinterpret_cast<__m256i*>(q + i), p);
+    }
+    return m / 32767.0f;
+  }
+
+  // MLP down projection into y (pre branch gain), plus the hidden-gain
+  // correction, then x += gm*y + bm
+  void e10_mlp_out(int l, int nnz) {
+    MlpArenas& mm = M.mlp[l];
+    float* y = e10_ym[l];
+    std::memset(y, 0, sizeof(float) * D);
+    if (nnz > DOWN_DENSE_NNZ)
+      qsparse4_dense_add(mm.down, q768, y);
+    else
+      qsparse4_add(mm.down, q768, idx768, nnz, y);
+    const float* g = e10_gm[l];
+    const float* b = e10_bm[l];
+    for (int i = 0; i < D; i++) x[i] += g[i] * y[i] + b[i];
+    if (e10_lora(l)) {
+      const int r = e10.rank;
+      const float* A = e10_A.data() + size_t(l) * r * D;
+      const float* B = e10_B.data() + size_t(l) * D * r;
+      float* u = e10_u[l];
+      for (int k = 0; k < r; k++) {
+        float acc = 0.0f;
+        for (int i = 0; i < D; i++) acc += A[size_t(k) * D + i] * e10_xnm[l][i];
+        u[k] = acc;
+      }
+      for (int i = 0; i < D; i++) {
+        float acc = 0.0f;
+        for (int k = 0; k < r; k++) acc += B[size_t(i) * r + k] * u[k];
+        x[i] += acc;
+      }
+    }
+  }
+
+  // grad of the MLP block's input x given dy = grad of its down output y;
+  // ghg[k] (nullable) = grad of the hidden gain of nonzero neuron k.
+  // Uses the forward arenas (no weight copies); integer dot products with
+  // int16-quantized gradients (exact, order-free), STE through quantizers.
+  void e10_mlp_back(int l, const float* dy, float* dx, float* ghg) {
+    const MlpArenas& mm = M.mlp[l];
+    const float* wsd = M.e10_dn_ws[l].data();
+    const float* wsu = M.e10_up_ws[l].data();
+    alignas(64) float gf[D];
+    for (int o = 0; o < D; o++) gf[o] = dy[o] * wsd[o];
+    alignas(64) int16_t gq[D];
+    const float sg = e10_q16(gf, D, gq);
+    int32_t gsum = 0;
+    for (int o = 0; o < D; o++) gsum += gq[o];
+    const float* yv = e10_y[l];
+    const float* gh = e10_gh[l];
+    const int nnz = e10_knnz[l];  // kept neurons (forward: code >= qmin)
+    alignas(64) uint16_t idx[DMLP + 16];
+    std::memcpy(idx, e10_kidx[l], sizeof(uint16_t) * nnz);
+    e10_stat_nnz += e10_nnz[l];
+    e10_stat_kept += nnz;
+    alignas(64) float c[DMLP + 16];
+    // software prefetch (exact, no numeric effect): the 2 lines of the down
+    // column and the 6 lines of the up row of neuron k + PF, so the dxn pass
+    // below also finds its rows in L1/L2
+    constexpr int PF = 8;
+    const uint8_t* const upa = mm.up.m.arena;
+    auto pf = [&](int i) {
+      const char* cp = reinterpret_cast<const char*>(mm.down.cols) + size_t(i) * 128;
+      _mm_prefetch(cp, _MM_HINT_T0);
+      _mm_prefetch(cp + 64, _MM_HINT_T0);
+      const char* rp = reinterpret_cast<const char*>(upa) + size_t(i >> 3) * 1600 +
+                       64 + (i & 7) * 32;
+      for (int c = 0; c < 6; c++) _mm_prefetch(rp + c * 256, _MM_HINT_T0);
+    };
+    for (int k = 0; k < nnz && k < PF; k++) pf(idx[k]);
+    for (int k = 0; k < nnz; k++) {
+      const int i = idx[k];
+      if (k + PF < nnz) pf(idx[k + PF]);
+      const int32_t d = e10_col_dot(mm.down.cols + size_t(i) * 128, gq);
+      const float dhp = sg * float(d - 7 * gsum);  // dL/dh'_i
+      const float r = std::max(yv[i], 0.0f);
+      if (ghg) ghg[k] = dhp * (r * r);
+      c[k] = 2.0f * r * gh[i] * dhp * wsu[i];  // dL/dy_i * up scale
+    }
+    int n = nnz;
+    if (n & 1) {  // pad to even with a zero coefficient
+      idx[n] = n ? idx[n - 1] : 0;
+      c[n] = 0.0f;
+      n++;
+    }
+    const int n16 = (n + 15) & ~15;
+    for (int k = n; k < n16; k++) c[k] = 0.0f;
+    alignas(64) int16_t cq[DMLP + 16];
+    const float sc = e10_q16(c, n16, cq);
+    alignas(64) int32_t acc[D];
+    alignas(64) float dxn[D];
+    if (n > 0 && sc > 0.0f) {
+      e10_rows_axpy(mm.up.m.arena, idx, cq, n, acc);
+      for (int j = 0; j < D; j++) dxn[j] = sc * float(acc[j]);
+    } else {
+      for (int j = 0; j < D; j++) dxn[j] = 0.0f;
+    }
+    const float* xnm = e10_xnm[l];
+    float m = 0.0f;
+    for (int i = 0; i < D; i++) m += dxn[i] * xnm[i];
+    m *= (1.0f / float(D));
+    const float rr = e10_rinvm[l];
+    for (int i = 0; i < D; i++) dx[i] = rr * (dxn[i] - xnm[i] * m);
+  }
+
+  void e10_step(float* th, float* v, const float* g, int n, float lr,
+                float init, float bc) {
+    if (e10.opt == 0) {
+      for (int i = 0; i < n; i++) th[i] -= lr * g[i];
+    } else {
+      const float b = e10.beta, b1 = 1.0f - e10.beta, eps = e10.eps;
+      for (int i = 0; i < n; i++) {
+        v[i] = b * v[i] + b1 * (g[i] * g[i]);
+        th[i] -= lr * g[i] / (std::sqrt(v[i] * bc) + eps);
+      }
+    }
+    if (e10.decay > 0.0f) {
+      const float k = 1.0f - e10.decay;
+      for (int i = 0; i < n; i++) th[i] = init + (th[i] - init) * k;
+    }
+  }
+
+  void e10_update(uint8_t y) {
+    if (!e10.on) return;
+    e10_bt *= e10.beta;
+    e10_stat_steps++;
+    const float bc = 1.0f / (1.0f - e10_bt);
+    alignas(64) float dl[208];
+    for (int o = 0; o < V; o++) {
+      const float d = e10_p[o] - (o == int(y) ? 1.0f : 0.0f);
+      const float c = e10_lc[o] * (1.0f / 15.0f);
+      dl[o] = d * (1.0f - c * c);
+    }
+    dl[205] = dl[206] = dl[207] = 0.0f;
+    alignas(64) float gxn[D];
+    const float* U = M.unembed_f32.data();
+    for (int half = 0; half < 2; half++) {
+      const int i0 = half * 96;
+      __m256 a[12];
+      for (int r = 0; r < 12; r++) a[r] = _mm256_setzero_ps();
+      for (int o = 0; o < V; o++) {
+        const float* row = U + size_t(o) * D + i0;
+        const __m256 g = _mm256_set1_ps(dl[o]);
+        for (int r = 0; r < 12; r++)
+          a[r] = _mm256_fmadd_ps(_mm256_loadu_ps(row + 8 * r), g, a[r]);
+      }
+      for (int r = 0; r < 12; r++) _mm256_store_ps(gxn + i0 + 8 * r, a[r]);
+    }
+    float m = 0.0f;
+    for (int i = 0; i < D; i++) m += gxn[i] * e10_xnf[i];
+    m *= (1.0f / float(D));
+    alignas(64) float G[D], gg[D], dy[D], dxm[D];
+    alignas(64) float ghg[DMLP];
+    alignas(64) float Gs[6][D] = {};

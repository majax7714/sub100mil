+// [sub100mil E10] dynamic evaluation: the transformer's OWN parameters are
+// adapted online (zero-init deltas on top of the frozen weights; runtime state
+// only, identical in compressor and decompressor; nothing in the archive).
+// Adapted parameters, per layer l in [lmin, 11]:
+//   sites bit0: per-channel gain on the attention/KDA branch output (192)
+//   sites bit1: per-channel gain on the MLP branch output (192)
+//   sites bit2: bias on the attention/KDA branch output (192)
+//   sites bit3: bias on the MLP branch output (192)
+//   sites bit4: per-neuron gain on the MLP hidden relu^2 code (768),
+//               only in the top mlpbk layers (needs the MLP backward)
+//   sites bit5: low-rank residual branch x += B (A xn_mlp) at the MLP
+//               (A rank x 192 fixed-LCG init, B 192 x rank zero init)
+// Gradient: CE of the main head at the coded token, back through the frozen
+// unembedding + final RMS norm, then down the residual stream (skip and
+// residual coefficients exact). Attention/KDA Jacobians are dropped
+// (truncated, current-position-only backprop); the MLP Jacobian is included
+// exactly (STE through quantizers) for the top mlpbk layers.
+// Optimizer: opt 0 = SGD; opt 1 = Adam-style RMS normalization (beta, eps,
+// bias-corrected), plus an optional decay toward the frozen value.
+struct E10Config {
+  int on = 0;
+  int sites = 3;
+  int lmin = 0;
+  int mlpbk = 0;
+  int opt = 1;
+  float lr = 1e-4f;     // gains
+  float lrb = 1e-4f;    // biases
+  float lrh = 1e-4f;    // hidden-neuron gains
+  float beta = 0.999f;
+  float eps = 1e-6f;
+  float decay = 0.0f;
+  int rank = 4;          // sites bit5: low-rank branch rank (<= 16)
+  float lrl = 1e-5f;     // its rate
+  float ainit = 0.07f;   // A init amplitude (uniform)
+};

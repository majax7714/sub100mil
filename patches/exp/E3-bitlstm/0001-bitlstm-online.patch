+};
+
+Head g;
+bool g_built = false;
+
+void Head::Configure() {
+  enabled = (int)EnvL("BITL", 1);
+  mode = (int)EnvL("BITL_MODE", 0);
+  C = (int)EnvL("BITL_CELLS", 16);
+  nhid = (int)EnvL("BITL_NHID", 32);
+  lr = (float)EnvL("BITL_LR_E6", 300) * 1e-6f;
+  accum = (int)EnvL("BITL_ACCUM", 16);
+  seq = (int)EnvL("BITL_SEQ", 1024);
+  fastbw = (int)EnvL("BITL_FASTBW", 1);
+  stats = (int)EnvL("BITL_STATS", 0);
+  // columns to drop, as a bit mask over the stage-1 row (hex)
+  const char* dm = std::getenv("BITL_DROP");
+  drop_mask = (dm && *dm) ? std::strtoull(dm, nullptr, 16) : 0ULL;
+  if (C <= 0 || C % 8 || nhid < 0 || nhid % 8 || accum < 1 || seq < 1 ||
+      mode < 0 || mode > 1) {
+    std::fprintf(stderr, "BITL: bad configuration\n");
+    std::exit(3);
+  }
+  if (aux_hid == nullptr) aux_n_hid = 0;
+}
+
+void Head::Build(int n_stage1) {
+  n1 = n_stage1;
+  n1keep = 0;
+  for (int j = 0; j < n1; ++j) if (!((drop_mask >> j) & 1ULL)) ++n1keep;
+  // feature row: [stage-1 kept][m1raw, t/T, (t/T)^2, sgn t, pos one-hot 8]
+  //              [prev_bit][hid sketch nhid]
+  kPrev = n1keep + kBaseExtra;
+  kHid = kPrev + 1;
+  nin = kHid + nhid;              // including prev_bit
+  inw = (nin + 7) & ~7;
+
+  if (nhid > 0 && aux_n_hid > 0) {
+    hidP = Alloc(aux_n_hid * nhid);
+    Rng prng(0x4849445052ULL);   // "HIDPR", as in neif
+    const float sc = 1.0f / std::sqrt((float)aux_n_hid);
+    // Same draw order as neif (row r of the sketch, column cc of the state),
+    // stored transposed so the projection vectorises over r.
+    for (int r = 0; r < nhid; ++r)
+      for (int cc = 0; cc < aux_n_hid; ++cc)
+        hidP[cc * nhid + r] = (prng.Uniform(1.0f) >= 0.0f) ? sc : -sc;
+  }
+  hidC = Alloc(nhid > 0 ? nhid : 8);
+
+  win = Alloc(C * inw); bin = Alloc(C);
+  wih = Alloc(4 * C * C); whh = Alloc(4 * C * C);
+  bg = Alloc(4 * C); wout = Alloc(C);
+  m1win = Alloc(C * inw); m1bin = Alloc(C);
+  m1wih = Alloc(4 * C * C); m1whh = Alloc(4 * C * C);
+  m1bg = Alloc(4 * C); m1wout = Alloc(C);
+  m2win = Alloc(C * inw); m2bin = Alloc(C);
+  m2wih = Alloc(4 * C * C); m2whh = Alloc(4 * C * C);
+  m2bg = Alloc(4 * C); m2wout = Alloc(C);
+  h = Alloc(C); c = Alloc(C); hprev = Alloc(C); cprev = Alloc(C);
+  x = Alloc(inw); z = Alloc(C); sg = Alloc(C); a = Alloc(C);
+  gi = Alloc(C); gf = Alloc(C); gg = Alloc(C); go = Alloc(C); tc = Alloc(C);
+  pre = Alloc(4 * C); dpre = Alloc(4 * C); da = Alloc(C);
+  const int W = seq;
+  bx = Alloc(W * inw);
+  bz = Alloc(W * C); bsg = Alloc(W * C); ba = Alloc(W * C);
+  bgi = Alloc(W * C); bgf = Alloc(W * C); bgg = Alloc(W * C); bgo = Alloc(W * C);
+  btc = Alloc(W * C); bh = Alloc(W * C); bc = Alloc(W * C); bdl = Alloc(W);
+  gwin = Alloc(C * inw); gbin = Alloc(C);
+  gwih = Alloc(4 * C * C); gwhh = Alloc(4 * C * C);
+  gbg = Alloc(4 * C); gwout = Alloc(C);
+  dhn = Alloc(C); dcn = Alloc(C); wsh = Alloc(C); wsc = Alloc(C);
+  bdp = Alloc(W * 4 * C); bdz = Alloc(W * C);
+  winT = Alloc(inw * C); wihT = Alloc(C * 4 * C); whhT = Alloc(C * 4 * C);
+
+  // neif's initialisation: PyTorch-style uniform hidden layers, forget-gate
+  // bias +1, output layer exactly zero (the head starts as a no-op).
+  Rng rng(0x42495431ULL);  // "BIT1"
+  const float bin_lim = 1.0f / std::sqrt((float)inw);
+  for (int r = 0; r < C; ++r) {
+    for (int j = 0; j < inw; ++j) win[r * inw + j] = rng.Uniform(bin_lim);
+    for (int j = nin; j < inw; ++j) win[r * inw + j] = 0.0f;
+    bin[r] = rng.Uniform(bin_lim);
+  }
+  const float hid_lim = 1.0f / std::sqrt((float)C);
+  for (int k = 0; k < 4 * C * C; ++k) wih[k] = rng.Uniform(hid_lim);
+  for (int k = 0; k < 4 * C * C; ++k) whh[k] = rng.Uniform(hid_lim);
+  for (int k = 0; k < 4 * C; ++k) bg[k] = rng.Uniform(hid_lim);
+  for (int r = 0; r < C; ++r) bg[1 * C + r] += 1.0f;
+  for (int r = 0; r < C; ++r) wout[r] = 0.0f;
+  bout = 0.0f;
+  Transpose();
+  std::fprintf(stderr,
+      "BITL: mode %d, %d cells, %d inputs (%d of %d stage-1 cols, hid %d of %d), "
+      "lr %g, accum %d, seq %d, %d params\n",
+      mode, C, nin, n1keep, n1, nhid, aux_n_hid, (double)lr, accum, seq,
+      C * inw + C + 8 * C * C + 4 * C + C + 1);
+}
+
+void Head::Transpose() {
+  for (int r = 0; r < C; ++r)
+    for (int j = 0; j < inw; ++j) winT[j * C + r] = win[r * inw + j];
+  for (int k = 0; k < 4 * C; ++k)
+    for (int r = 0; r < C; ++r) {
+      wihT[r * 4 * C + k] = wih[k * C + r];
+      whhT[r * 4 * C + k] = whh[k * C + r];
+    }
+}
+
+void Head::Forward() {
+  // in_proj: lane-parallel over outputs (transposed weights), output blocks
+  // of up to 32 cells, even/odd input partial sums added at the end.
+  for (int r0 = 0; r0 < C; r0 += 32) {
+    const int nv = (C - r0) >= 32 ? 4 : (C - r0) / 8;
+    __m256 e[4], o[4];
+    for (int v = 0; v < 4; ++v) { e[v] = _mm256_setzero_ps(); o[v] = _mm256_setzero_ps(); }
+    for (int j = 0; j + 1 < inw; j += 2) {
+      const __m256 x0 = _mm256_set1_ps(x[j]), x1 = _mm256_set1_ps(x[j + 1]);
+      for (int v = 0; v < nv; ++v) {
+        e[v] = _mm256_fmadd_ps(_mm256_loadu_ps(winT + j * C + r0 + 8 * v), x0, e[v]);
+        o[v] = _mm256_fmadd_ps(_mm256_loadu_ps(winT + (j + 1) * C + r0 + 8 * v), x1, o[v]);
+      }
+    }
+    for (int v = 0; v < nv; ++v)
+      _mm256_storeu_ps(z + r0 + 8 * v, _mm256_add_ps(_mm256_add_ps(e[v], o[v]),
+                                                     _mm256_loadu_ps(bin + r0 + 8 * v)));
+  }
+  for (int r = 0; r < C; r += 8) {
+    const __m256 zv = _mm256_loadu_ps(z + r);
+    const __m256 s = Sigmoid8(zv);
+    _mm256_storeu_ps(sg + r, s);
+    _mm256_storeu_ps(a + r, _mm256_mul_ps(zv, s));
+  }
+  {
+    // gates: pre = wih a + whh hprev + bg, blocks of up to 64 gate rows.
+    const int G = 4 * C;
+    for (int k0 = 0; k0 < G; k0 += 64) {
+      const int nv = (G - k0) >= 64 ? 8 : (G - k0) / 8;
+      __m256 ua[8], uh[8];
+      for (int v = 0; v < 8; ++v) { ua[v] = _mm256_setzero_ps(); uh[v] = _mm256_setzero_ps(); }
+      for (int r = 0; r < C; ++r) {
+        const __m256 av = _mm256_set1_ps(a[r]);
+        for (int v = 0; v < nv; ++v)
+          ua[v] = _mm256_fmadd_ps(_mm256_loadu_ps(wihT + r * G + k0 + 8 * v), av, ua[v]);
+      }
+      for (int r = 0; r < C; ++r) {
+        const __m256 hv = _mm256_set1_ps(hprev[r]);
+        for (int v = 0; v < nv; ++v)
+          uh[v] = _mm256_fmadd_ps(_mm256_loadu_ps(whhT + r * G + k0 + 8 * v), hv, uh[v]);
+      }
+      for (int v = 0; v < nv; ++v)
+        _mm256_storeu_ps(pre + k0 + 8 * v, _mm256_add_ps(_mm256_add_ps(ua[v], uh[v]),
+                                                         _mm256_loadu_ps(bg + k0 + 8 * v)));
+    }
+  }
+  for (int r = 0; r < C; r += 8) {
+    const __m256 vi = Sigmoid8(_mm256_loadu_ps(pre + 0 * C + r));
+    const __m256 vf = Sigmoid8(_mm256_loadu_ps(pre + 1 * C + r));
+    const __m256 vg = Tanh8(_mm256_loadu_ps(pre + 2 * C + r));
+    const __m256 vo = Sigmoid8(_mm256_loadu_ps(pre + 3 * C + r));
+    const __m256 cn = _mm256_fmadd_ps(vf, _mm256_loadu_ps(cprev + r),
+                                      _mm256_mul_ps(vi, vg));
+    const __m256 th = Tanh8(cn);
+    _mm256_storeu_ps(gi + r, vi);
+    _mm256_storeu_ps(gf + r, vf);
+    _mm256_storeu_ps(gg + r, vg);
+    _mm256_storeu_ps(go + r, vo);
+    _mm256_storeu_ps(c + r, cn);
+    _mm256_storeu_ps(tc + r, th);
+    _mm256_storeu_ps(h + r, _mm256_mul_ps(vo, th));
+  }
+  delta = DotPadded(wout, h, C) + bout;
+  const size_t n = sizeof(float) * (size_t)C;
+  const int o0 = nbuf * C;
+  std::memcpy(bx + (size_t)nbuf * (size_t)inw, x, sizeof(float) * (size_t)inw);
+  std::memcpy(bz + o0, z, n);   std::memcpy(bsg + o0, sg, n);
+  std::memcpy(ba + o0, a, n);   std::memcpy(bgi + o0, gi, n);
+  std::memcpy(bgf + o0, gf, n); std::memcpy(bgg + o0, gg, n);
+  std::memcpy(bgo + o0, go, n); std::memcpy(btc + o0, tc, n);
+  std::memcpy(bh + o0, h, n);   std::memcpy(bc + o0, c, n);
+}
+
+void Head::BackwardWindow() {
+  const int W = nbuf;
+  if (W <= 0) return;
+  if (agrp == 0) {
+    std::memset(gwin, 0, sizeof(float) * (size_t)(C * inw));
+    std::memset(gbin, 0, sizeof(float) * (size_t)C);
+    std::memset(gwih, 0, sizeof(float) * (size_t)(4 * C * C));
+    std::memset(gwhh, 0, sizeof(float) * (size_t)(4 * C * C));
+    std::memset(gbg, 0, sizeof(float) * (size_t)(4 * C));
+    std::memset(gwout, 0, sizeof(float) * (size_t)C);
+    gbout = 0.0f;
+  }
+  for (int r = 0; r < C; ++r) { dhn[r] = 0.0f; dcn[r] = 0.0f; }
+  for (int tt = W - 1; tt >= 0; --tt) {
+    const int o0 = tt * C;
+    const float dl = bdl[tt];
+    for (int r = 0; r < C; ++r) gwout[r] += dl * bh[o0 + r];
+    gbout += dl;
+    for (int r = 0; r < C; ++r) da[r] = dl * wout[r] + dhn[r];
+    const float* hprev_t = (tt > 0) ? (bh + o0 - C) : wsh;
+    const float* cprev_t = (tt > 0) ? (bc + o0 - C) : wsc;
+    for (int r = 0; r < C; ++r) {
+      const float th = btc[o0 + r];
+      const float go_ = bgo[o0 + r];
+      const float gf_ = bgf[o0 + r];
+      const float gi_ = bgi[o0 + r];
+      const float gg_ = bgg[o0 + r];
+      const float dc = da[r] * go_ * (1.0f - th * th) + dcn[r];
+      dpre[3 * C + r] = da[r] * th * go_ * (1.0f - go_);
+      dpre[0 * C + r] = dc * gg_ * gi_ * (1.0f - gi_);
+      dpre[2 * C + r] = dc * gi_ * (1.0f - gg_ * gg_);
+      dpre[1 * C + r] = dc * cprev_t[r] * gf_ * (1.0f - gf_);
+      dcn[r] = dc * gf_;
+    }
+    for (int r = 0; r < C; ++r) { da[r] = 0.0f; dhn[r] = 0.0f; }
+    const float* a_t = ba + o0;
+    for (int k = 0; k < 4 * C; ++k) {
+      const float d = dpre[k];
+      GateRowBack(gwih + k * C, gwhh + k * C, da, dhn, wih + k * C,
+                  whh + k * C, a_t, hprev_t, d, C);
+      gbg[k] += d;
+    }
+    const float* x_t = bx + (size_t)tt * (size_t)inw;
+    for (int r = 0; r < C; ++r) {
+      const float sv = bsg[o0 + r];
+      const float dz = da[r] * (sv + bz[o0 + r] * sv * (1.0f - sv));
+      AxpyNoFma(gwin + (size_t)r * (size_t)inw, x_t, dz, inw);
+      gbin[r] += dz;
+    }
+  }
+  ++agrp;
+  if (agrp >= accum) {
+    FinishGroup();
+    agrp = 0;
+    nvalid = 0;
+  }
+}
+
+// Same gradient as BackwardWindow (different, but fixed, summation order):
+// the per-step pass only propagates da/dhn (register-accumulated mat-vec)
+// and stores dpre/dz; the weight gradients are then accumulated as
+// register-tiled outer-product sums over the window.  This keeps the
+// accumulators out of the per-step loop, where they did not fit in L1.
+void Head::BackwardWindowFast() {
+  const int W = nbuf;
+  if (W <= 0) return;
+  if (agrp == 0) {
+    std::memset(gwin, 0, sizeof(float) * (size_t)(C * inw));
+    std::memset(gbin, 0, sizeof(float) * (size_t)C);
+    std::memset(gwih, 0, sizeof(float) * (size_t)(4 * C * C));
+    std::memset(gwhh, 0, sizeof(float) * (size_t)(4 * C * C));
+    std::memset(gbg, 0, sizeof(float) * (size_t)(4 * C));
+    std::memset(gwout, 0, sizeof(float) * (size_t)C);
+    gbout = 0.0f;
+  }
+  const int G = 4 * C;
+  for (int r = 0; r < C; ++r) { dhn[r] = 0.0f; dcn[r] = 0.0f; }
+  for (int tt = W - 1; tt >= 0; --tt) {
+    const int o0 = tt * C;
+    const float dl = bdl[tt];
+    for (int r = 0; r < C; ++r) da[r] = dl * wout[r] + dhn[r];
+    const float* cprev_t = (tt > 0) ? (bc + o0 - C) : wsc;
+    float* dp = bdp + (size_t)tt * G;
+    for (int r = 0; r < C; ++r) {
+      const float th = btc[o0 + r];
+      const float go_ = bgo[o0 + r];
+      const float gf_ = bgf[o0 + r];
+      const float gi_ = bgi[o0 + r];
+      const float gg_ = bgg[o0 + r];
+      const float dc = da[r] * go_ * (1.0f - th * th) + dcn[r];
+      dp[3 * C + r] = da[r] * th * go_ * (1.0f - go_);
+      dp[0 * C + r] = dc * gg_ * gi_ * (1.0f - gi_);
+      dp[2 * C + r] = dc * gi_ * (1.0f - gg_ * gg_);
+      dp[1 * C + r] = dc * cprev_t[r] * gf_ * (1.0f - gf_);
+      dcn[r] = dc * gf_;
+    }
+    // da = wih^T dp, dhn = whh^T dp, accumulated in registers over k.
+    for (int r0 = 0; r0 < C; r0 += 8) {
+      __m256 va = _mm256_setzero_ps(), vh = _mm256_setzero_ps();
+      for (int k = 0; k < G; ++k) {
+        const __m256 d = _mm256_set1_ps(dp[k]);
+        va = _mm256_fmadd_ps(_mm256_loadu_ps(wih + k * C + r0), d, va);
+        vh = _mm256_fmadd_ps(_mm256_loadu_ps(whh + k * C + r0), d, vh);
+      }
+      _mm256_storeu_ps(da + r0, va);
+      _mm256_storeu_ps(dhn + r0, vh);
+    }
+    for (int r = 0; r < C; ++r) {
+      const float sv = bsg[o0 + r];
+      bdz[o0 + r] = da[r] * (sv + bz[o0 + r] * sv * (1.0f - sv));
+    }
+  }
+  // Weight gradients: sums over the window in t order.
+  for (int tt = 0; tt < W; ++tt) {
+    const float dl = bdl[tt];
+    gbout += dl;
+    for (int r = 0; r < C; ++r) gwout[r] += dl * bh[tt * C + r];
+    for (int k = 0; k < G; ++k) gbg[k] += bdp[(size_t)tt * G + k];
+    for (int r = 0; r < C; ++r) gbin[r] += bdz[tt * C + r];
+  }
+  // gwih[k][r] += sum_t dp_t[k] a_t[r];  gwhh[k][r] += sum_t dp_t[k] h_{t-1}[r]
+  // (h_{-1} = wsh = 0 after the window reset, so t starts at 1 for gwhh).
+  for (int k0 = 0; k0 < G; k0 += 4) {
+    for (int r0 = 0; r0 < C; r0 += 8) {
+      __m256 ai[4], ah[4];
+      for (int q = 0; q < 4; ++q) {
+        ai[q] = _mm256_loadu_ps(gwih + (k0 + q) * C + r0);
+        ah[q] = _mm256_loadu_ps(gwhh + (k0 + q) * C + r0);
+      }
+      for (int tt = 0; tt < W; ++tt) {
+        const float* dp = bdp + (size_t)tt * G + k0;
+        const __m256 av = _mm256_loadu_ps(ba + tt * C + r0);
+        const __m256 hv = (tt > 0) ? _mm256_loadu_ps(bh + (tt - 1) * C + r0)
+                                   : _mm256_loadu_ps(wsh + r0);
+        for (int q = 0; q < 4; ++q) {
+          const __m256 d = _mm256_set1_ps(dp[q]);
+          ai[q] = _mm256_fmadd_ps(d, av, ai[q]);
+          ah[q] = _mm256_fmadd_ps(d, hv, ah[q]);
+        }
+      }
+      for (int q = 0; q < 4; ++q) {
+        _mm256_storeu_ps(gwih + (k0 + q) * C + r0, ai[q]);
+        _mm256_storeu_ps(gwhh + (k0 + q) * C + r0, ah[q]);
+      }
+    }
+  }
+  // gwin[r][j] += sum_t dz_t[r] x_t[j], tiles of 2 rows x 4 vectors.
+  for (int r = 0; r < C; r += 2) {
+    for (int j0 = 0; j0 < inw; j0 += 32) {
+      const int nv = (inw - j0) >= 32 ? 4 : (inw - j0) / 8;
+      __m256 a0[4], a1[4];
+      for (int v = 0; v < nv; ++v) {
+        a0[v] = _mm256_loadu_ps(gwin + r * inw + j0 + 8 * v);
+        a1[v] = _mm256_loadu_ps(gwin + (r + 1) * inw + j0 + 8 * v);
+      }
+      for (int tt = 0; tt < W; ++tt) {
+        const float* xt = bx + (size_t)tt * inw + j0;
+        const __m256 d0 = _mm256_set1_ps(bdz[tt * C + r]);
+        const __m256 d1 = _mm256_set1_ps(bdz[tt * C + r + 1]);
+        for (int v = 0; v < nv; ++v) {
+          const __m256 xv = _mm256_loadu_ps(xt + 8 * v);
+          a0[v] = _mm256_fmadd_ps(d0, xv, a0[v]);
+          a1[v] = _mm256_fmadd_ps(d1, xv, a1[v]);
+        }
+      }
+      for (int v = 0; v < nv; ++v) {
+        _mm256_storeu_ps(gwin + r * inw + j0 + 8 * v, a0[v]);
+        _mm256_storeu_ps(gwin + (r + 1) * inw + j0 + 8 * v, a1[v]);
+      }
+    }
+  }
+  ++agrp;
+  if (agrp >= accum) {
+    FinishGroup();
+    agrp = 0;
+    nvalid = 0;
+  }
+}
+
+void Head::FinishGroup() {
+  const int nw = C * inw, ng = 4 * C * C, nb = 4 * C;
+  if (nvalid > 0) {
+    const float sc = 1.0f / (float)nvalid;
+    for (int k = 0; k < nw; ++k) gwin[k] *= sc;
+    for (int k = 0; k < C; ++k) gbin[k] *= sc;
+    for (int k = 0; k < ng; ++k) gwih[k] *= sc;
+    for (int k = 0; k < ng; ++k) gwhh[k] *= sc;
+    for (int k = 0; k < nb; ++k) gbg[k] *= sc;
+    for (int k = 0; k < C; ++k) gwout[k] *= sc;
+    gbout *= sc;
+  }
+  double ss = 0.0;
+  for (int k = 0; k < nw; ++k) ss += (double)gwin[k] * (double)gwin[k];
+  for (int k = 0; k < C; ++k) ss += (double)gbin[k] * (double)gbin[k];
+  for (int k = 0; k < ng; ++k) ss += (double)gwih[k] * (double)gwih[k];
+  for (int k = 0; k < ng; ++k) ss += (double)gwhh[k] * (double)gwhh[k];
+  for (int k = 0; k < nb; ++k) ss += (double)gbg[k] * (double)gbg[k];
+  for (int k = 0; k < C; ++k) ss += (double)gwout[k] * (double)gwout[k];
+  ss += (double)gbout * (double)gbout;
+  std::uint64_t nb_bits;
+  std::memcpy(&nb_bits, &ss, sizeof nb_bits);
+  if (((nb_bits >> 52) & 0x7FFu) == 0x7FFu) { ++n_skipped; return; }
+  const double nrm = std::sqrt(ss);
+  if (nrm > (double)clip) {
+    const float sc = (float)((double)clip / nrm);
+    for (int k = 0; k < nw; ++k) gwin[k] *= sc;
+    for (int k = 0; k < C; ++k) gbin[k] *= sc;
+    for (int k = 0; k < ng; ++k) gwih[k] *= sc;
+    for (int k = 0; k < ng; ++k) gwhh[k] *= sc;
+    for (int k = 0; k < nb; ++k) gbg[k] *= sc;
+    for (int k = 0; k < C; ++k) gwout[k] *= sc;
+    gbout *= sc;
+  }
+  Apply();
+  Transpose();
+  ++n_steps;
+}
+
+void Head::Apply() {
+  Hyp hp;
+  hp.b1 = b1; hp.b2 = b2; hp.eps = eps;
+  b1t *= (double)b1;
+  b2t *= (double)b2;
+  hp.lr = (float)((double)lr * std::sqrt(1.0 - b2t) / (1.0 - b1t));
+  RowUpdate(wout, m1wout, m2wout, gwout, hp, C);
+  ScalarUpdate(&bout, &m1bout, &m2bout, gbout, hp);
+  for (int k = 0; k < 4 * C; ++k) {
+    RowUpdate(wih + k * C, m1wih + k * C, m2wih + k * C, gwih + k * C, hp, C);
+    RowUpdate(whh + k * C, m1whh + k * C, m2whh + k * C, gwhh + k * C, hp, C);
+    ScalarUpdate(bg + k, m1bg + k, m2bg + k, gbg[k], hp);
+  }
+  for (int r = 0; r < C; ++r) {
+    RowUpdate(win + r * inw, m1win + r * inw, m2win + r * inw, gwin + r * inw,
+              hp, inw);
+    ScalarUpdate(bin + r, m1bin + r, m2bin + r, gbin[r], hp);
+  }
+}
+
+// Builds the feature row, runs the forward pass, returns the clamped delta.
+float Head::Run(unsigned int base_p, float tlogit, const float* stage1,
+                int n_stage1, float m1raw) {
+  (void)base_p;
+  if (!g_built) { Build(n_stage1); g_built = true; }
+  if (n_stage1 != n1) {
+    std::fprintf(stderr, "BITL: stage-1 width changed %d -> %d\n", n1, n_stage1);
+    std::abort();
+  }
+  if (nbuf == 0) {
+    for (int r = 0; r < C; ++r) { h[r] = 0.0f; c[r] = 0.0f; }
+    std::memcpy(wsh, h, sizeof(float) * (size_t)C);
+    std::memcpy(wsc, c, sizeof(float) * (size_t)C);
+  }
+  std::memcpy(hprev, h, sizeof(float) * (size_t)C);
+  std::memcpy(cprev, c, sizeof(float) * (size_t)C);
+
+  t = tlogit;
+  const float inv_t = 1.0f / kTScale;
+  for (int j = 0; j < inw; ++j) x[j] = 0.0f;
+  int w = 0;
+  for (int j = 0; j < n1; ++j) {
+    if ((drop_mask >> j) & 1ULL) continue;
+    x[w++] = stage1[j];
+  }
+  x[n1keep + 0] = m1raw;
+  const float tl = tlogit * inv_t;
+  x[n1keep + 1] = tl;
+  x[n1keep + 2] = tl * tl;
+  x[n1keep + 3] = Sgn(tlogit);
+  x[n1keep + 4 + (int)(i & 7)] = 1.0f;
+  x[kPrev] = prev_bit;
+  if (nhid > 0 && aux_hid != nullptr && hidP != nullptr) {
+    const unsigned long long b = i >> 3;
+    if (b != hid_byte) {
+      hid_byte = b;
+      // hidC[r] = sum_cc P[r][cc] * hid[cc], accumulated in cc order per lane.
+      // all output blocks in one pass, even/odd cc partial sums
+      for (int r0 = 0; r0 < nhid; r0 += 32) {
+        const int nv = (nhid - r0) >= 32 ? 4 : (nhid - r0) / 8;
+        __m256 e[4], o[4];
+        for (int v = 0; v < 4; ++v) { e[v] = _mm256_setzero_ps(); o[v] = _mm256_setzero_ps(); }
+        int cc = 0;
+        for (; cc + 1 < aux_n_hid; cc += 2) {
+          const __m256 h0 = _mm256_set1_ps(aux_hid[cc]);
+          const __m256 h1 = _mm256_set1_ps(aux_hid[cc + 1]);
+          for (int v = 0; v < nv; ++v) {
+            e[v] = _mm256_fmadd_ps(_mm256_loadu_ps(hidP + cc * nhid + r0 + 8 * v), h0, e[v]);
+            o[v] = _mm256_fmadd_ps(_mm256_loadu_ps(hidP + (cc + 1) * nhid + r0 + 8 * v), h1, o[v]);
+          }
+        }
+        for (int v = 0; v < nv; ++v) _mm256_storeu_ps(hidC + r0 + 8 * v, _mm256_add_ps(e[v], o[v]));
+      }
+    }
+    for (int r = 0; r < nhid; ++r) x[kHid + r] = hidC[r];
+  }
+  Forward();
+  float d = delta;
+  if (d > clamp) d = clamp;
+  else if (d < -clamp) d = -clamp;
+  return d;
+}
+
+void Head::Learn(int bit) {
+  if (stats) {
+    // measurement only: code length of this bit under base and head p
+    const double pb = (bit ? pend_base : 65536 - pend_base) / 65536.0;
+    const double ph = (bit ? pend_head : 65536 - pend_head) / 65536.0;
+    win_base -= std::log2(pb); win_head -= std::log2(ph);
+    if (((i + 1) & ((1ULL << 23) - 1)) == 0) {
+      cost_base += win_base; cost_head += win_head;
+      std::fprintf(stderr, "BITL stats @%llu bytes: window gain %.0f B, total gain %.0f B (base %.0f B)\n",
+                   (i + 1) >> 3, (win_base - win_head) / 8, (cost_base - cost_head) / 8, cost_base / 8);
+      win_base = win_head = 0.0;
+    }
+  }
+  bdl[nbuf] = skip ? 0.0f : (Sigmoidf(t + delta) - (float)bit);
+  if (!skip) ++nvalid;
+  ++nbuf;
+  if (nbuf >= seq) {
+    if (fastbw) BackwardWindowFast(); else BackwardWindow();
+    nbuf = 0;
+  }
+  prev_bit = (float)bit;
+  ++i;
+}
+
+}  // namespace
+
+bool Init() {
+  g.Configure();
+  return true;
+}
+bool Enabled() { return g.enabled != 0; }
+int Mode() { return g.mode; }
+
+void SetAux(const float* hid, int n_hid) {
+  g.aux_hid = hid;
+  g.aux_n_hid = hid ? n_hid : 0;
+}
+
+__attribute__((noinline))
+unsigned int Adjust(unsigned int base_p, const float* stage1, int n_stage1,
+                    float m1raw, int override_active) {
+  const float p1 = (float)base_p / 65536.0f;
+  const float t = std::log(p1 / (1.0f - p1));
+  const float d = g.Run(base_p, t, stage1, n_stage1, m1raw);
+  g.skip = override_active ? 1 : 0;
+  g.pend_base = g.pend_head = base_p;
+  if (override_active) return base_p;
+  const float pnew = Sigmoidf(t + d);
+  unsigned int q = (unsigned int)(1.0f + 65534.0f * pnew);
+  if (q < 1) q = 1;
+  if (q > 65535) q = 65535;
+  g.pend_head = q;
+  return q;
+}
+
+__attribute__((noinline))
+void Observe(int bit) {
+  g.Learn(bit);
+}
+
+__attribute__((noinline))
+float PredictInput(const float* stage1, int n_stage1, int override_active) {
+  // t = 0, m1raw = 0: the head is a standalone recurrent predictor over the
+  // stage-1 row; its logit goes to the final mixer.
+  const float d = g.Run(32768, 0.0f, stage1, n_stage1, 0.0f);
+  g.skip = override_active ? 1 : 0;
+  return d;
+}
+
+__attribute__((noinline))
+void ObserveInput(int bit) { g.Learn(bit); }
+
+void Report() {
+  if (!g_built) return;
+  std::fprintf(stderr, "BITL: %llu bits, %llu optimizer steps, %llu skipped\n",
+               g.i, g.n_steps, g.n_skipped);
+}
+
+}  // namespace bit_head

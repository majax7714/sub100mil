+// [sub100mil E3] BITLSTM correction head, online-only port.  Contract in
+// bit_head.h.
+//
+// This translation unit MUST be compiled without fast-math and with
+// -ffp-contract=off (makefile rule bit_head.o, no LTO, no PGO).
+//
+// ATTRIBUTION.  Ported from src/bit_head.cpp of cmix-neif-1.0 (marwoelk,
+// GPL-3.0-only).  There: the AVX2 kernels Exp8/Sigmoid8/Tanh8 and the
+// fixed-order DotPadded reduction are ported line by line from
+// src/models/bitlstm32-head.cpp of cmix-obias (David Freelan, GPL-3.0); Exp8
+// is an altered exp256_ps of avx_mathfun.h (Giovanni Garberoglio, 2012),
+// itself based on sse_mathfun.h (Julien Pommier, 2007), zlib licence; its
+// polynomial is the Cephes expf of Stephen L. Moshier.  The buffered TBPTT
+// backward pass, Adam step, gradient clipping and the fixed state projection
+// are neif's.  Changes here: no compiled-in weights (online from bit 0),
+// runtime configuration, no byte-LSTM/SSE/zone blocks, a vectorised
+// (fixed-order) transformer-state projection, and mode 1 (head as an extra
+// final-mixer input).
+
+#include "bit_head.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include <immintrin.h>
+
+namespace bit_head {
+namespace {
+
+constexpr float kTScale = 12.203f;
+// +0 m1raw/T... see layout in Head
+constexpr int kBaseExtra = 12;
+
+inline float Sigmoidf(float x) { return 1.0f / (1.0f + std::exp(-x)); }
+inline float Sgn(float x) { return (x > 0.0f) ? 1.0f : (x < 0.0f ? -1.0f : 0.0f); }
+
+inline __m256 Exp8(__m256 x) {
+  const __m256 exp_hi = _mm256_set1_ps(88.3762626647949f);
+  const __m256 exp_lo = _mm256_set1_ps(-88.3762626647949f);
+  const __m256 log2e = _mm256_set1_ps(1.44269504088896341f);
+  const __m256 c1 = _mm256_set1_ps(0.693359375f);
+  const __m256 c2 = _mm256_set1_ps(-2.12194440e-4f);
+  const __m256 p0 = _mm256_set1_ps(1.9875691500e-4f);
+  const __m256 p1 = _mm256_set1_ps(1.3981999507e-3f);
+  const __m256 p2 = _mm256_set1_ps(8.3334519073e-3f);
+  const __m256 p3 = _mm256_set1_ps(4.1665795894e-2f);
+  const __m256 p4 = _mm256_set1_ps(1.6666665459e-1f);
+  const __m256 p5 = _mm256_set1_ps(5.0000001201e-1f);
+  const __m256 one = _mm256_set1_ps(1.0f);
+  x = _mm256_min_ps(x, exp_hi);
+  x = _mm256_max_ps(x, exp_lo);
+  __m256 fx = _mm256_fmadd_ps(x, log2e, _mm256_set1_ps(0.5f));
+  fx = _mm256_floor_ps(fx);
+  x = _mm256_fnmadd_ps(fx, c1, x);
+  x = _mm256_fnmadd_ps(fx, c2, x);
+  const __m256 z = _mm256_mul_ps(x, x);
+  __m256 y = p0;
+  y = _mm256_fmadd_ps(y, x, p1);
+  y = _mm256_fmadd_ps(y, x, p2);
+  y = _mm256_fmadd_ps(y, x, p3);
+  y = _mm256_fmadd_ps(y, x, p4);
+  y = _mm256_fmadd_ps(y, x, p5);
+  y = _mm256_fmadd_ps(y, z, x);
+  y = _mm256_add_ps(y, one);
+  const __m256i imm = _mm256_add_epi32(_mm256_cvttps_epi32(fx),
+                                       _mm256_set1_epi32(0x7f));
+  const __m256 pow2n = _mm256_castsi256_ps(_mm256_slli_epi32(imm, 23));
+  return _mm256_mul_ps(y, pow2n);
+}
+inline __m256 Sigmoid8(__m256 x) {
+  const __m256 one = _mm256_set1_ps(1.0f);
+  return _mm256_div_ps(one, _mm256_add_ps(one,
+      Exp8(_mm256_sub_ps(_mm256_setzero_ps(), x))));
+}
+inline __m256 Tanh8(__m256 x) {
+  const __m256 one = _mm256_set1_ps(1.0f);
+  const __m256 e = Exp8(_mm256_mul_ps(x, _mm256_set1_ps(-2.0f)));
+  return _mm256_div_ps(_mm256_sub_ps(one, e), _mm256_add_ps(one, e));
+}
+
+inline float DotPadded(const float* w, const float* x, int n_padded) {
+  __m256 acc = _mm256_setzero_ps();
+  for (int j = 0; j < n_padded; j += 8) {
+    acc = _mm256_fmadd_ps(_mm256_loadu_ps(w + j), _mm256_loadu_ps(x + j), acc);
+  }
+  __m128 lo = _mm256_castps256_ps128(acc);
+  __m128 hi = _mm256_extractf128_ps(acc, 1);
+  __m128 s = _mm_add_ps(lo, hi);
+  s = _mm_add_ps(s, _mm_movehl_ps(s, s));
+  s = _mm_add_ss(s, _mm_shuffle_ps(s, s, 1));
+  return _mm_cvtss_f32(s);
+}
+
+inline void AxpyNoFma(float* __restrict acc, const float* __restrict v,
+                      float sc, int n) {
+  const __m256 vs = _mm256_set1_ps(sc);
+  for (int j = 0; j < n; j += 8) {
+    _mm256_storeu_ps(acc + j,
+        _mm256_add_ps(_mm256_loadu_ps(acc + j),
+                      _mm256_mul_ps(vs, _mm256_loadu_ps(v + j))));
+  }
+}
+
+inline void GateRowBack(float* __restrict gwih_k, float* __restrict gwhh_k,
+                        float* __restrict dav, float* __restrict dhnv,
+                        const float* __restrict wih_k,
+                        const float* __restrict whh_k,
+                        const float* __restrict a_t,
+                        const float* __restrict hprev_t, float d, int n) {
+  const __m256 vd = _mm256_set1_ps(d);
+  for (int r = 0; r < n; r += 8) {
+    _mm256_storeu_ps(gwih_k + r,
+        _mm256_add_ps(_mm256_loadu_ps(gwih_k + r),
+                      _mm256_mul_ps(vd, _mm256_loadu_ps(a_t + r))));
+    _mm256_storeu_ps(gwhh_k + r,
+        _mm256_add_ps(_mm256_loadu_ps(gwhh_k + r),
+                      _mm256_mul_ps(vd, _mm256_loadu_ps(hprev_t + r))));
+    _mm256_storeu_ps(dav + r,
+        _mm256_add_ps(_mm256_loadu_ps(dav + r),
+                      _mm256_mul_ps(_mm256_loadu_ps(wih_k + r), vd)));
+    _mm256_storeu_ps(dhnv + r,
+        _mm256_add_ps(_mm256_loadu_ps(dhnv + r),
+                      _mm256_mul_ps(_mm256_loadu_ps(whh_k + r), vd)));
+  }
+}
+
+struct Hyp { float lr, b1, b2, eps; };
+
+// Adam, bias correction folded into lr.
+inline __m256 Step8(__m256 g, float* m1, float* m2, int j, const Hyp& hp) {
+  const __m256 b1 = _mm256_set1_ps(hp.b1);
+  const __m256 b2 = _mm256_set1_ps(hp.b2);
+  const __m256 one = _mm256_set1_ps(1.0f);
+  const __m256 mv = _mm256_fmadd_ps(b1, _mm256_loadu_ps(m1 + j),
+                                    _mm256_mul_ps(_mm256_sub_ps(one, b1), g));
+  const __m256 sv = _mm256_fmadd_ps(b2, _mm256_loadu_ps(m2 + j),
+      _mm256_mul_ps(_mm256_sub_ps(one, b2), _mm256_mul_ps(g, g)));
+  _mm256_storeu_ps(m1 + j, mv);
+  _mm256_storeu_ps(m2 + j, sv);
+  return _mm256_div_ps(mv, _mm256_add_ps(_mm256_sqrt_ps(sv),
+                                         _mm256_set1_ps(hp.eps)));
+}
+inline float Step1(float g, float* m1, float* m2, const Hyp& hp) {
+  const float mv = hp.b1 * (*m1) + (1.0f - hp.b1) * g;
+  const float sv = hp.b2 * (*m2) + (1.0f - hp.b2) * g * g;
+  *m1 = mv; *m2 = sv;
+  return mv / (std::sqrt(sv) + hp.eps);
+}
+inline void RowUpdate(float* w, float* m1, float* m2, const float* g,
+                      const Hyp& hp, int n) {
+  const __m256 vlr = _mm256_set1_ps(hp.lr);
+  for (int j = 0; j < n; j += 8) {
+    __m256 wv = _mm256_loadu_ps(w + j);
+    const __m256 step = Step8(_mm256_loadu_ps(g + j), m1, m2, j, hp);
+    wv = _mm256_fnmadd_ps(vlr, step, wv);
+    _mm256_storeu_ps(w + j, wv);
+  }
+}
+inline void ScalarUpdate(float* w, float* m1, float* m2, float g,
+                         const Hyp& hp) {
+  *w = *w - hp.lr * Step1(g, m1, m2, hp);
+}
+
+struct Rng {
+  uint64_t s;
+  explicit Rng(uint64_t seed) : s(seed) {}
+  uint64_t Next() {
+    uint64_t z = (s += 0x9e3779b97f4a7c15ULL);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    return z ^ (z >> 31);
+  }
+  float Uniform(float b) {
+    const uint32_t r = (uint32_t)(Next() >> 40);
+    const float u = (float)r * (1.0f / 16777216.0f);
+    return (2.0f * u - 1.0f) * b;
+  }
+};
+
+long EnvL(const char* k, long d) {
+  const char* v = std::getenv(k);
+  return (v && *v) ? std::strtol(v, nullptr, 10) : d;
+}
+
+float* Alloc(int n) {
+  return (float*)std::calloc((size_t)(n > 0 ? n : 1), sizeof(float));
+}
+
+struct Head {
+  // ---- configuration (Init) ----
+  int enabled = 0;
+  int mode = 0;          // 0 = final logit correction, 1 = final-mixer input
+  int C = 16;            // cells, multiple of 8
+  int nhid = 32;         // transformer-state sketch width, multiple of 8 (0 = off)
+  int n1 = 0;            // stage-1 width (fixed on first call)
+  int n1keep = 0;
+  unsigned long long drop_mask = 0;   // stage-1 columns NOT fed
+  float lr = 3e-4f, b1 = 0.9f, b2 = 0.999f, eps = 1e-8f;
+  float clamp = 8.0f, clip = 1.0f;
+  int seq = 1024, accum = 16;
+  int kPrev = 0, kHid = 0, nin = 0, inw = 0;
+  double b1t = 1.0, b2t = 1.0;
+  int agrp = 0;
+  unsigned long long nvalid = 0;
+
+  float *win = nullptr, *bin = nullptr, *wih = nullptr, *whh = nullptr,
+        *bg = nullptr, *wout = nullptr;
+  float bout = 0.0f;
+  float *m1win, *m2win, *m1bin, *m2bin, *m1wih, *m2wih, *m1whh, *m2whh,
+        *m1bg, *m2bg, *m1wout, *m2wout;
+  float m1bout = 0.0f, m2bout = 0.0f;
+
+  float *h, *c, *hprev, *cprev;
+  float prev_bit = 0.5f;
+  unsigned long long i = 0;
+
+  float *x, *z, *sg, *a, *gi, *gf, *gg, *go, *tc, *pre, *dpre, *da;
+  float delta = 0.0f, t = 0.0f;
+  int skip = 0;
+
+  const float* aux_hid = nullptr;
+  int aux_n_hid = 0;
+  float* hidP = nullptr;   // aux_n_hid x nhid (transposed: one row per input)
+  float* hidC = nullptr;
+  unsigned long long hid_byte = ~0ULL;
+
+  int nbuf = 0;
+  float *bx, *bz, *bsg, *ba, *bgi, *bgf, *bgg, *bgo, *btc, *bh, *bc, *bdl;
+  float *gwin, *gbin, *gwih, *gwhh, *gbg, *gwout;
+  float gbout = 0.0f;
+  float *dhn, *dcn, *wsh, *wsc;
+
+  double cost_base = 0.0, cost_head = 0.0, win_base = 0.0, win_head = 0.0;
+  int stats = 0;
+  unsigned int pend_base = 32768, pend_head = 32768;
+  unsigned long long n_steps = 0, n_skipped = 0;
+
+  void Configure();
+  void Build(int n_stage1);
+  void Forward();
+  void BackwardWindow();
+  void BackwardWindowFast();
+  void FinishGroup();
+  int fastbw = 1;
+  float *winT = nullptr, *wihT = nullptr, *whhT = nullptr;  // forward copies
+  void Transpose();
+  float *bdp = nullptr, *bdz = nullptr;
+  void Apply();
+  float Run(unsigned int base_p, float tlogit, const float* stage1,
+            int n_stage1, float m1raw);

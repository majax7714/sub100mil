@@ -0,0 +1,53 @@
+#ifndef BIT_HEAD_H_
+#define BIT_HEAD_H_
+
+// [sub100mil E3] BITLSTM: a small LSTM that corrects the final bit probability
+// in logit space, immediately before the arithmetic coder:
+//
+//     x -> in_proj -> SiLU -> LSTMCell(C) -> linear(1) -> delta
+//     t = ln(p/(1-p));  p' = sigmoid(t + delta)
+//
+// Ported from cmix-neif-1.0 src/bit_head.{h,cpp} (marwoelk, GPL-3.0-only),
+// whose form, AVX2 kernels and several input features come from the
+// bitlstm32 head of cmix-obias (David Freelan, GPL-3.0).  This port is
+// ONLINE-ONLY: deterministic splitmix64 initialisation, output layer zero
+// (exact no-op on the first bit), Adam with buffered truncated BPTT, no
+// trained weights.
+//
+// Determinism: one translation unit compiled WITHOUT fast-math and with
+// -ffp-contract=off (makefile rule bit_head.o), noinline entry points, fixed
+// reduction order.  The configuration is read once from the environment in
+// Init() (BITL_*), so encoder and decoder must run with the same environment.
+//
+// The rest of the predictor never sees the corrected probability.
+
+namespace bit_head {
+
+// Reads the configuration (BITL_* env) and builds the head.  n_hid = width of
+// the transformer state vector registered with SetAux (0 = none).
+bool Init();
+bool Enabled();
+
+// Registers the per-byte transformer state vector (192 floats, stable
+// pointer); nullptr = no transformer (the block is fed zeros).
+void SetAux(const float* hid, int n_hid);
+
+// One call per coded bit, after base_p = Discretize(Predict()).
+// stage1/n_stage1 = the final mixer's input row, m1raw = raw final mixer
+// output (logit), override_active = byte-mixer 0/1 override.
+unsigned int Adjust(unsigned int base_p, const float* stage1, int n_stage1,
+                    float m1raw, int override_active);
+// Learns from the coded bit; exactly one call after each Adjust().
+void Observe(int bit);
+
+// Logit-domain output of the head (mode 1 = extra final-mixer input):
+// a standalone prediction from the stage-1 row, returned as a stretched value.
+float PredictInput(const float* stage1, int n_stage1, int override_active);
+void ObserveInput(int bit);
+
+int Mode();
+void Report();
+
+}  // namespace bit_head
+
+#endif

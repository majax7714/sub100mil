+// [E1] Transformer-confidence contexts. Variants (compile-time):
+//   E1_MIX1   final (layer-1) mixer weight set selected by the confidence context
+//   E1_MX13   layer-0 mixer mx13 (context = partial byte) gets confidence*256 + partial byte
+//   E1_MIXNEW extra layer-0 mixer, context = confidence*256 + partial byte
+//   E1_GATE   transformer stretch(p) copied into one of 16 (=1) or 16+4 (=2) gated
+//             layer-0 inputs selected by the confidence buckets (others 0);
+//             =3 adds 4 entropy- and 4 margin-gated, =4: 16 + 64 (per-bit x top1-prob)
+//   E1_APM    extra APM after the SSE, context = confidence (x bpos or x partial byte)
+// Interpolating APM over the stretched probability, 49 knots on [-12, 12].
+struct E1Apm {
+  std::vector<float> t;
+  int idx = 0;
+  float w = 0;
+  explicit E1Apm(int contexts) : t((size_t)contexts * 49) {
+    for (int c = 0; c < contexts; ++c)
+      for (int j = 0; j < 49; ++j) t[(size_t)c * 49 + j] = Sigmoid::Logistic((j - 24) * 0.5f);
+  }
+  float Pp(float st, int cx) {
+    if (st < -11.999f) st = -11.999f;
+    if (st > 11.999f) st = 11.999f;
+    float x = (st + 12.0f) * 2.0f;
+    int lo = (int)x;
+    w = x - lo;
+    idx = cx * 49 + lo;
+    return t[idx] * (1 - w) + t[idx + 1] * w;
+  }
+  void Update(int y, float rate) {
+    t[idx] += (y - t[idx]) * rate * (1 - w);
+    t[idx + 1] += (y - t[idx + 1]) * rate * w;
+  }
+};
+#endif

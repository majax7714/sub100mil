+// [G1] GLN final stage on the coder's probability (after the BITLSTM head). Skipped on override bits.
+unsigned int Predictor::G1Adjust(unsigned int q) {
+  g1_active_ = false;
+  if (!g1_ || bitl_override_) return q;
+  float X[g1::KX], Z[g1::ZD];
+  g1::Features(&layers_[1].Inputs()[0], (int)mixer_0_.size(), bitl_m1raw_, g1_psse_,
+               g1::Stretch(q / 65536.0f), (int)e1_cb_, X, Z);
+  const float p = g1_->Squash(g1_->Predict(X, Z));
+  unsigned int q2 = (unsigned int)(1.0f + 65534.0f * p);
+  if (q2 < 1) q2 = 1;
+  if (q2 > 65535) q2 = 65535;
+  g1_active_ = true;
+  return q2;
+}
